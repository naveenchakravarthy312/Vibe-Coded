#!/usr/bin/env bash
set -euo pipefail
BUNDLE_MACOS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT_DIR="$(cd "$BUNDLE_MACOS_DIR/../../.." && pwd)"
if [[ -x "$APP_ROOT_DIR/.venv/bin/python3" ]]; then
    exec "$APP_ROOT_DIR/.venv/bin/python3" "$APP_ROOT_DIR/music_player.py" "$@"
elif [[ -x "$APP_ROOT_DIR/.venv/bin/python" ]]; then
    exec "$APP_ROOT_DIR/.venv/bin/python" "$APP_ROOT_DIR/music_player.py" "$@"
fi
exec /usr/bin/env python3 "$APP_ROOT_DIR/music_player.py" "$@"
